#!/bin/bash
# Pleasure video: renames Higgsfield downloads to slot numbers.
# Put this file in the folder with the downloads, then run in Terminal:  bash rename_files_MAC.command
cd "$(dirname "$0")" || exit 1
r(){ for f in *"$1"*; do [ -e "$f" ] || { echo "MISSING $2"; return; }; mv -n "$f" "$2.${f##*.}"; echo "$f -> $2.${f##*.}"; done; }
