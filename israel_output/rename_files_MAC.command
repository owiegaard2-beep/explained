#!/bin/bash
# Israel video: renames Higgsfield downloads into order.
# Put this file in the same folder as the downloads, then run:  bash rename_files_MAC.command
cd "$(dirname "$0")" || exit 1
r(){ for f in *"$1"*; do [ -e "$f" ] || { echo "MISSING $2"; return; }; mv -n "$f" "$2.${f##*.}"; echo "$f -> $2.${f##*.}"; done; }
